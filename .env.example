# Postgres bootstrap (superuser)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Published host ports
BACKEND_PORT=8080
FRONTEND_PORT=3000
OPENPIM_PORT=80

# File storage mount (host path)
FILE_STORAGE_PATH=./filestorage

# OpenPIM login used by backend GraphQL client (optional)
OPENPIM_LOGIN=admin
OPENPIM_PASSWORD=admin

# OpenPIM application database role/database
PIM_DB=pim_db
PIM_ADMIN=pim_admin
PIM_ADMIN_PASSWORD=change_me_strong_password
